{
  "name": "onto-the-tv",
  "version": "0.4.0",
  "description": "Offline family shuffle and local-network Samsung TV playback, together on your Mac.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "productName": "Onto the TV",
  "main": "src/main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "start": "electron .",
    "install-app": "python3 scripts/install_mac_app.py",
    "test": "node --test src/*.test.js casting/test/*.test.js shuffler/tests/player.test.js",
    "test:python": "cd shuffler && python3 -m unittest discover -s tests && python3 -m unittest test_sync_phone",
    "cast": "node casting/src/cli.js"
  },
  "devDependencies": {
    "electron": "44.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
